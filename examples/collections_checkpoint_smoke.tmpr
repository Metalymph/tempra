import std.strings

fn double_int(x: Int) -> Int {
    return x * 2
}

fn is_even_int(x: Int) -> Bool {
    return x == 2 || x == 4
}

fn is_positive_int(x: Int) -> Bool {
    return x > 0
}

fn is_three_int(x: Int) -> Bool {
    return x == 3
}

fn add_int(a: Int, b: Int) -> Int {
    return a + b
}

fn observe_int(x: Int) {
    return
}

fn main() -> Int64 {
    let xs: Array(Int) = [1, 2, 3, 4]
    let sl: Slice(Int) = xs[1..4]
    let empty: Array(Int) = []

    if xs.is_empty() { return 1 }
    if !empty.is_empty() { return 2 }
    if sl.is_empty() { return 3 }

    let first = xs.first()
    if first is Some(v) {
        if v != 1 { return 4 }
    } else {
        return 5
    }

    let last = sl.last()
    if last is Some(v) {
        if v != 4 { return 6 }
    } else {
        return 7
    }

    let empty_first = empty.first()
    if empty_first is Some(v) {
        return 8
    }

    var it = xs.iter()
    let next_one = it.next()
    if next_one is Some(v) {
        if v != 1 { return 9 }
    } else {
        return 10
    }
    let next_two = it.next()
    if next_two is Some(v) {
        if v != 2 { return 11 }
    } else {
        return 12
    }

    var array_sum = 0
    for x in xs {
        array_sum = array_sum + x
    }
    if array_sum != 10 { return 13 }

    var slice_sum = 0
    for x in sl {
        slice_sum = slice_sum + x
    }
    if slice_sum != 9 { return 14 }

    var string_count = 0
    for b in "hello" {
        string_count = string_count + 1
    }
    if string_count != 5 { return 15 }

    var string_iter = "ok".iter()
    var string_iter_count = 0
    let sb1 = string_iter.next()
    if sb1 is Some(v) {
        string_iter_count = string_iter_count + 1
    } else {
        return 16
    }
    let sb2 = string_iter.next()
    if sb2 is Some(v) {
        string_iter_count = string_iter_count + 1
    } else {
        return 17
    }
    let sb3 = string_iter.next()
    if sb3 is Some(v) {
        return 18
    }
    if string_iter_count != 2 { return 19 }

    var bytes_count = 0
    for b in "hey".bytes() {
        bytes_count = bytes_count + 1
    }
    if bytes_count != 3 { return 20 }

    let mapped = xs.map(double_int)
    if mapped.count() != 4 { return 21 }
    if mapped[0] != 2 { return 22 }
    if mapped[3] != 8 { return 23 }

    let filtered = xs.filter(is_even_int)
    if filtered.count() != 2 { return 24 }
    if filtered[0] != 2 { return 25 }
    if filtered[1] != 4 { return 26 }

    let found = xs.find(is_three_int)
    if found is Some(v) {
        if v != 3 { return 27 }
    } else {
        return 28
    }
    if !xs.any(is_three_int) { return 29 }
    if !xs.all(is_positive_int) { return 30 }
    xs.for_each(observe_int)

    let reduced = xs.reduce(add_int)
    if reduced is Some(v) {
        if v != 10 { return 31 }
    } else {
        return 32
    }
    if xs.fold(100, add_int) != 110 { return 33 }

    let empty_reduced = empty.reduce(add_int)
    if empty_reduced is Some(v) {
        return 34
    }
    if empty.fold(100, add_int) != 100 { return 35 }

    let enumerated = xs.enumerate()
    if enumerated.len() != 4 { return 36 }
    let enum_ok = match enumerated[2] {
        (index, value) => index == 2 && value == 3,
        _ => false,
    }
    if !enum_ok { return 37 }

    let ys: Array(Int) = [10, 20]
    let zipped = xs.zip(ys)
    if zipped.len() != 2 { return 38 }
    let zip_ok = match zipped[1] {
        (left, right) => left == 2 && right == 20,
        _ => false,
    }
    if !zip_ok { return 39 }

    let taken = xs.take(3)
    if taken.len() != 3 { return 40 }
    if taken[2] != 3 { return 41 }

    let skipped = xs.skip(2)
    if skipped.len() != 2 { return 42 }
    if skipped[0] != 3 { return 43 }

    let chained = xs.skip(1).take(2).chain(ys)
    if chained.len() != 4 { return 44 }
    if chained[0] != 2 { return 45 }
    if chained[1] != 3 { return 46 }
    if chained[2] != 10 { return 47 }
    if chained[3] != 20 { return 48 }

    let trimmed = std.strings.trim("  hello tempra  ")
    if trimmed != "hello tempra" { return 49 }
    if !std.strings.contains(trimmed, "tempra") { return 50 }
    if !std.strings.starts_with(trimmed, "hello") { return 51 }
    if !std.strings.ends_with(trimmed, "tempra") { return 52 }
    let replaced = std.strings.replace(trimmed, "tempra", "collections")
    if replaced != "hello collections" { return 53 }

    return 0
}
