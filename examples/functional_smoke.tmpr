import std.io

fn double(x: Int) -> Int {
    return x * 2
}

fn is_greater_than_one(x: Int) -> Bool {
    return x > 1
}

fn is_positive(x: Int) -> Bool {
    return x > 0
}

fn is_three(x: Int) -> Bool {
    return x == 3
}

fn print_seen(x: Int) {
    std.io.println("for_each saw value")
    return
}

pub fn main() -> Int64 {
    let xs: [Int] = [1, 2, 3]
    let sl = xs[0..3]

    let mapped = xs.map(double)
    if mapped.count() != 3 { return 1 }
    if mapped[0] != 2 { return 2 }
    if mapped[2] != 6 { return 3 }

    let filtered = xs.filter(is_greater_than_one)
    if filtered.count() != 2 { return 4 }
    if filtered[0] != 2 { return 5 }
    if filtered[1] != 3 { return 6 }

    let found: Option(Int) = xs.find(is_greater_than_one)
    if found is Some(v) {
        if v != 2 { return 7 }
    } else {
        return 8
    }

    if !xs.any(is_three) { return 9 }
    if !xs.all(is_positive) { return 10 }
    if xs.count() != 3 { return 11 }
    xs.for_each(print_seen)

    let slice_mapped = sl.map(double)
    if slice_mapped.count() != 3 { return 12 }
    if slice_mapped[0] != 2 { return 13 }
    if slice_mapped[2] != 6 { return 14 }

    let slice_filtered = sl.filter(is_greater_than_one)
    if slice_filtered.count() != 2 { return 15 }
    if slice_filtered[0] != 2 { return 16 }
    if slice_filtered[1] != 3 { return 17 }

    let slice_found: Option(Int) = sl.find(is_greater_than_one)
    if slice_found is Some(v) {
        if v != 2 { return 18 }
    } else {
        return 19
    }

    if !sl.any(is_three) { return 20 }
    if !sl.all(is_positive) { return 21 }
    if sl.count() != 3 { return 22 }
    sl.for_each(print_seen)

    std.io.println("functional collection smoke passed")
    return 0
}
