fn classify(n: Int64) -> Int64 {
    if n < 0 {
        return -1
    } else {
        if n == 0 {
            return 0
        } else {
            if n > 100 {
                return 2
            } else {
                return 1
            }
        }
    }
}

fn main() -> Int64 {
    var total = 0
    total = total + classify(-10)
    total = total + classify(0)
    total = total + classify(5)
    total = total + classify(50)
    total = total + classify(150)
    // Expected: -1 + 0 + 1 + 1 + 2 = 3
    return total
}
// 10 times this would be 30.
