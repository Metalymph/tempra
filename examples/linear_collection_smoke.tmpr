fn main() -> Int64 {
    let xs: Array(Int64) = [1, 2, 3, 4, 5, 6, 7, 8]

    let take_zero = xs.take(0)
    if take_zero.len() != 0 { return 1 }

    let take_partial = xs.take(3)
    if take_partial.len() != 3 { return 2 }
    if take_partial[0] != 1 { return 3 }
    if take_partial[2] != 3 { return 4 }

    let take_exact = xs.take(8)
    if take_exact.len() != 8 { return 5 }
    if take_exact[7] != 8 { return 6 }

    let take_greater = xs.take(100)
    if take_greater.len() != 8 { return 7 }

    let take_negative = xs.take(-1)
    if take_negative.len() != 0 { return 8 }

    let skip_zero = xs.skip(0)
    if skip_zero.len() != 8 { return 9 }
    if skip_zero[0] != 1 { return 10 }

    let skip_partial = xs.skip(5)
    if skip_partial.len() != 3 { return 11 }
    if skip_partial[0] != 6 { return 12 }

    let skip_exact = xs.skip(8)
    if skip_exact.len() != 0 { return 13 }

    let skip_greater = xs.skip(100)
    if skip_greater.len() != 0 { return 14 }

    let skip_negative = xs.skip(-1)
    if skip_negative.len() != 8 { return 15 }
    if skip_negative[7] != 8 { return 16 }

    let empty: Array(Int64) = []
    if empty.take(3).len() != 0 { return 17 }
    if empty.skip(3).len() != 0 { return 18 }

    let ys: Array(Int64) = [9, 10]
    let chained = xs.take(2).chain(ys)
    if chained.len() != 4 { return 19 }
    if chained[0] != 1 { return 20 }
    if chained[3] != 10 { return 21 }

    let xs_slice: Slice(Int64) = xs[2..5]
    let ys_slice: Slice(Int64) = ys[0..2]
    let slice_chain = xs_slice.chain(ys_slice)
    if slice_chain.len() != 5 { return 22 }
    if slice_chain[0] != 3 { return 23 }
    if slice_chain[4] != 10 { return 24 }

    let combined = xs.skip(2).take(5).chain(ys)
    if combined.len() != 7 { return 25 }
    if combined[0] != 3 { return 26 }
    if combined[4] != 7 { return 27 }
    if combined[5] != 9 { return 28 }
    if combined[6] != 10 { return 29 }

    if empty.chain(ys).len() != 2 { return 30 }
    if ys.chain(empty).len() != 2 { return 31 }
    if empty.chain(empty).len() != 0 { return 32 }

    return 0
}
