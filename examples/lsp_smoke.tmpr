//   - Diagnostics → the BROKEN section at the bottom shows intentional errors
//   - Symbols     → open the document symbol outline to see Point, add, greeting
//   - Completion  → type `re` in a function to see `return`, or type inside `main` to see locals
//   - Highlighting → verify that keywords, types, functions, variables, parameters, and properties are highlighted via semantic tokens
//   - References  → trigger 'Find References' on `a` in `add` or `origin` in `main` to see all references
//   - Highlights  → place the cursor on `origin` or `a` to see all read/write occurrences highlighted
//   - Rename      → trigger 'Rename Symbol' on `origin` or `a` to safely rename all occurrences
//

struct Point {
    x: Int64
    y: Int64
}

fn add(a: Int64, b: Int64) -> Int64 {
    return a + b
}

fn greeting(name: String) -> String {
    let prefix = "Hello, "
    return prefix
}

fn describe(p: Point) -> Int64 {
    let total = add(p.x, p.y)
    return total
}

fn main() {
    let origin = Point { x: 0, y: 0 }
    let result = add(3, 4)
    let msg    = greeting("Tempra")
    let sum    = describe(origin)
    
    // Type `res` below to test local completion (e.g. `result`)
