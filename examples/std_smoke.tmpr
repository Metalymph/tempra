import std.fs;
import std.path;
import std.strings;
import std.io;

fn main() -> Int64 {
    io.println("--- Tempra Stdlib Smoke Test ---");

    // Path
    let p = path.join("foo", "bar.txt");
    io.print("Path join: ");
    io.println(p);

    let b = path.basename(p);
    io.print("Basename: ");
    io.println(b);

    // Strings
    let s = "Hello, Tempra!";
    let has_tempra = strings.contains(s, "Tempra");
    if has_tempra {
        io.println("String contains 'Tempra': true");
    } else {
        io.println("String contains 'Tempra': false");
    }

    let starts = strings.starts_with(s, "Hello");
    if starts {
        io.println("String starts with 'Hello': true");
    } else {
        io.println("String starts with 'Hello': false");
    }

    let ends = strings.ends_with(s, "!");
    if ends {
        io.println("String ends with '!': true");
    } else {
        io.println("String ends with '!': false");
    }

    // FS
    let exists = fs.exists("examples/std_smoke.tmpr");
    if exists {
        io.println("File exists: true");
    } else {
        io.println("File exists: false");
    }

    return 0;
}
