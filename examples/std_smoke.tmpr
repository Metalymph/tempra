import std.fs;
import std.path;
import std.strings;
import std.io;

fn main() -> Int64 {
    std.io.println("--- Tempra Stdlib Smoke Test ---");

    // Path
    let p = std.path.join("foo", "bar.txt");
    std.io.print("Path join: ");
    std.io.println(p);

    let b = std.path.basename(p);
    std.io.print("Basename: ");
    std.io.println(b);

    // Strings
    let s = "Hello, Tempra!";
    let has_tempra = std.strings.contains(s, "Tempra");
    if has_tempra {
        std.io.println("String contains 'Tempra': true");
    } else {
        std.io.println("String contains 'Tempra': false");
    }

    let starts = std.strings.starts_with(s, "Hello");
    if starts {
        std.io.println("String starts with 'Hello': true");
    } else {
        std.io.println("String starts with 'Hello': false");
    }

    let ends = std.strings.ends_with(s, "!");
    if ends {
        std.io.println("String ends with '!': true");
    } else {
        std.io.println("String ends with '!': false");
    }

    // FS
    let exists = std.fs.exists("examples/std_smoke.tmpr");
    if exists {
        std.io.println("File exists: true");
    } else {
        std.io.println("File exists: false");
    }

    let write_res = std.fs.write_text("examples/test_output.txt", "hello tempra");
    match write_res {
        Ok(_) => std.io.println("File write: success"),
        Err(e) => {
            std.io.print("File write failed: ");
            std.io.println(e);
        }
    }

    let read_res = std.fs.read_text("examples/test_output.txt");
    match read_res {
        Ok(text) => {
            std.io.print("File read: ");
            std.io.println(text);
        }
        Err(e) => {
            std.io.print("File read failed: ");
            std.io.println(e);
        }
    }

    return 0;
}
