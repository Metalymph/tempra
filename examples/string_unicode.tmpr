let s = "héllo"

print("s = ", s)
print("len (scalars) = ", s.len())
print("size (bytes)  = ", s.size())

print("Iteration:")
for ch in s {
    print("  ch = ", ch)
}

// Verification with different Unicode characters
let s2 = "你好"
print("s2 = ", s2)
print("len = ", s2.len())
print("size = ", s2.size())

for ch in s2 {
    print("  ch = ", ch)
}
