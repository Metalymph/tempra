fn main() -> Int64 {
    let xs: Array(Int) = [10, 20, 30]
    let ys: Array(Int) = [1, 2, 3]

    let idx0: Int64 = 0
    let idx1: Int64 = 1
    let idx2: Int64 = 2

    let array_enum = xs.enumerate()
    if array_enum.len() != 3 { return 1 }
    let array_enum_first_ok = match array_enum[0] {
        (index, value) => index == idx0 && value == 10,
        _ => false,
    }
    if !array_enum_first_ok { return 2 }
    let array_enum_last_ok = match array_enum[2] {
        (index, value) => index == idx2 && value == 30,
        _ => false,
    }
    if !array_enum_last_ok { return 3 }

    let xs_slice: Slice(Int) = xs[1..3]
    let slice_enum = xs_slice.enumerate()
    if slice_enum.len() != 2 { return 4 }
    let slice_enum_first_ok = match slice_enum[0] {
        (index, value) => index == idx0 && value == 20,
        _ => false,
    }
    if !slice_enum_first_ok { return 5 }
    let slice_enum_second_ok = match slice_enum[1] {
        (index, value) => index == idx1 && value == 30,
        _ => false,
    }
    if !slice_enum_second_ok { return 6 }

    let array_array = xs.zip(ys)
    if array_array.len() != 3 { return 7 }
    let array_array_ok = match array_array[1] {
        (left, right) => left == 20 && right == 2,
        _ => false,
    }
    if !array_array_ok { return 8 }

    let ys_slice: Slice(Int) = ys[0..2]
    let array_slice = xs.zip(ys_slice)
    if array_slice.len() != 2 { return 9 }
    let array_slice_ok = match array_slice[1] {
        (left, right) => left == 20 && right == 2,
        _ => false,
    }
    if !array_slice_ok { return 10 }

    let slice_array = xs_slice.zip(ys)
    if slice_array.len() != 2 { return 11 }
    let slice_array_ok = match slice_array[1] {
        (left, right) => left == 30 && right == 2,
        _ => false,
    }
    if !slice_array_ok { return 12 }

    let slice_slice = xs_slice.zip(ys_slice)
    if slice_slice.len() != 2 { return 13 }
    let slice_slice_ok = match slice_slice[0] {
        (left, right) => left == 20 && right == 1,
        _ => false,
    }
    if !slice_slice_ok { return 14 }

    let left_short: Array(Int) = [1]
    let right_long: Array(Int) = [10, 20, 30]
    if left_short.zip(right_long).len() != 1 { return 15 }

    let left_long: Array(Int) = [1, 2, 3]
    let right_short: Array(Int) = [10]
    if left_long.zip(right_short).len() != 1 { return 16 }

    let empty: Array(Int) = []
    if empty.zip(left_long).len() != 0 { return 17 }

    return 0
}
